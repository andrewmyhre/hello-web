{
  "components": {
    "schemas": {
      "ErrorDetail": {
        "additionalProperties": false,
        "properties": {
          "location": {
            "description": "Where the error occurred, e.g. 'body.items[3].tags' or 'path.thing-id'",
            "type": "string"
          },
          "message": {
            "description": "Error message text",
            "type": "string"
          },
          "value": {
            "description": "The value at the given location"
          }
        },
        "type": "object"
      },
      "ErrorModel": {
        "additionalProperties": false,
        "properties": {
          "detail": {
            "description": "A human-readable explanation specific to this occurrence of the problem.",
            "examples": [
              "Property foo is required but is missing."
            ],
            "type": "string"
          },
          "errors": {
            "description": "Optional list of individual error details",
            "items": {
              "$ref": "#/components/schemas/ErrorDetail"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "instance": {
            "description": "A URI reference that identifies the specific occurrence of the problem.",
            "examples": [
              "https://example.com/error-log/abc123"
            ],
            "format": "uri",
            "type": "string"
          },
          "status": {
            "description": "HTTP status code",
            "examples": [
              400
            ],
            "format": "int64",
            "type": "integer"
          },
          "title": {
            "description": "A short, human-readable summary of the problem type. This value should not change between occurrences of the error.",
            "examples": [
              "Bad Request"
            ],
            "type": "string"
          },
          "type": {
            "default": "about:blank",
            "description": "A URI reference to human-readable documentation for the error.",
            "examples": [
              "https://example.com/errors/example"
            ],
            "format": "uri",
            "type": "string"
          }
        },
        "type": "object"
      },
      "HealthOutputBody": {
        "additionalProperties": false,
        "properties": {
          "status": {
            "description": "Always ok while the server is serving.",
            "examples": [
              "ok"
            ],
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "type": "object"
      },
      "HelloOutputBody": {
        "additionalProperties": false,
        "properties": {
          "greeting": {
            "description": "The configured greeting.",
            "examples": [
              "Hello from the example feature"
            ],
            "type": "string"
          }
        },
        "required": [
          "greeting"
        ],
        "type": "object"
      },
      "MeOutputBody": {
        "additionalProperties": false,
        "properties": {
          "avatar": {
            "description": "Avatar URL.",
            "type": "string"
          },
          "email": {
            "description": "Email, shown only and never matched on. Empty unless Google says it is verified.",
            "type": "string"
          },
          "id": {
            "description": "Google account ID (the OIDC sub). This is the identity.",
            "type": "string"
          },
          "name": {
            "description": "Display name.",
            "type": "string"
          },
          "roles": {
            "description": "Every role the user is bound to, in every domain, read from the role bindings. Sorted by domain, then role.",
            "items": {
              "$ref": "#/components/schemas/MeRole"
            },
            "type": "array"
          }
        },
        "required": [
          "id",
          "name",
          "email",
          "avatar",
          "roles"
        ],
        "type": "object"
      },
      "MeRole": {
        "additionalProperties": false,
        "properties": {
          "domain": {
            "description": "Where the binding applies: global, or a project ID.",
            "type": "string"
          },
          "role": {
            "description": "Role name, for example Admin.",
            "type": "string"
          }
        },
        "required": [
          "role",
          "domain"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "title": "hello-web",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/auth/logout": {
      "post": {
        "operationId": "auth-logout",
        "responses": {
          "204": {
            "description": "No Content",
            "headers": {
              "Set-Cookie": {
                "schema": {
                  "description": "Clears the session cookie.",
                  "type": "string"
                }
              }
            }
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "End the session",
        "tags": [
          "auth"
        ]
      }
    },
    "/example/hello": {
      "get": {
        "operationId": "get-example-hello",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HelloOutputBody"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Return the example greeting",
        "tags": [
          "example"
        ]
      }
    },
    "/health": {
      "get": {
        "operationId": "get-health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthOutputBody"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Report that the server is serving",
        "tags": [
          "server"
        ]
      }
    },
    "/me": {
      "get": {
        "operationId": "get-me",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeOutputBody"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Return the signed-in user",
        "tags": [
          "auth"
        ]
      }
    }
  }
}
