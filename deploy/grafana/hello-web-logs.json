          "expr": "sum by (status) (count_over_time({kubernetes_namespace_name=\"$namespace\", app_kubernetes_io_part_of=\"hello-web\"} | json | service=\"hello-web\" | scope=~\"$scope\" | provider=~\"$provider\" | agent_id=~\"$agent_id\" | session_id=~\"$session_id\" | kind=~\"$kind\" | request_id=~\"$request_id\" | scope=\"api\" [$__auto]))",
          "queryType": "range",
          "legendFormat": "{{status}}"
