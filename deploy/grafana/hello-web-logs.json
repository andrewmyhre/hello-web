  "links": [],
  "panels": [
    {
      "id": 1,
      "title": "Lines by scope",
      "description": "Every hello-web line matching the filters, counted per scope.",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${datasource}"
          },
          "expr": "sum by (scope) (count_over_time({kubernetes_namespace_name=\"$namespace\", app_kubernetes_io_part_of=\"hello-web\"} | json | service=\"hello-web\" | scope=~\"$scope\" | provider=~\"$provider\" | agent_id=~\"$agent_id\" | session_id=~\"$session_id\" | kind=~\"$kind\" | request_id=~\"$request_id\" [$__auto]))",
          "queryType": "range",
          "legendFormat": "{{scope}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 80
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 2,
      "title": "API requests by status",
